pkgname=plasma-graphcore-linux
pkgver=0.14.1
pkgrel=1
pkgdesc='Account service and shared core of the Microsoft 365 apps for KDE Plasma'
arch=(x86_64)
url='https://github.com/nvaert1986/plasma-graphcore-linux'
license=(GPL-3.0-or-later)
# kirigami, kcmutils' QML and qt6-declarative: the System Settings page loads them at run time
depends=(glibc libstdc++
         qt6-base qt6-declarative qt6-networkauth qtkeychain-qt6
         kcmutils kconfig kcoreaddons ki18n kirigami knotifications)
makedepends=(cmake extra-cmake-modules)
optdepends=('kwallet: keeps the sign-in (or another Secret Service provider)'
            'systemsettings: System Settings > Microsoft 365 Accounts')
options=(!debug)
# Says that the sign-in needs a keychain (KDE Wallet switched on, or another Secret Service)
install=$pkgname.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # set from the tag tarball at release

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Built against the versions installed now, so they become the minimum: a system that was not
  # updated first (pacman -U without -Syu) otherwise fails at run time with "undefined symbol"
  local dep name ver
  local -a pinned=()
  for dep in "${depends[@]}"; do
    name=${dep%%[<>=]*}
    case $name in
      glibc|hicolor-icon-theme|xdg-utils|plasma-workspace|plasma-graphcore-linux) pinned+=("$dep"); continue ;;
    esac
    ver=$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)
    pinned+=("$name${ver:+>=${ver%-*}}")
  done
  depends=("${pinned[@]}")
}
