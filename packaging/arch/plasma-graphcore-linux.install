post_install() {
  echo ">>> The sign-in of the Microsoft 365 apps is kept in the keychain: KDE Wallet must be switched on"
  echo "    (System Settings > KDE Wallet), or another Secret Service provider (gnome-keyring, KeePassXC)."
}
